# Python
.venv/
__pycache__/
*.pyc

# dlt (local secrets/config dir, never committed)
.dlt/

# dbt (regenerated by `dbt build`/`dbt deps`; .user.yml holds an anonymous
# per-machine telemetry ID, not project state)
target/
dbt_packages/
logs/
.user.yml

# DuckDB database files, regenerated by load.py / dbt build
*.duckdb
*.duckdb.wal

# Ad-hoc data exports (e.g. one-off CSVs), not pipeline output
*.csv

# Secrets
.env

# Editor
.vscode/

# Version control (never needed inside the image)
.git

# Python: the image builds its own virtualenv from uv.lock, a host one
# (different paths/architecture) would overwrite it
.venv
__pycache__
*.pyc

# dbt: regenerated by `dbt deps` / `dbt build` inside the image
target
logs
dbt_packages
.user.yml

# DuckDB database files: the database is built fresh on every run, so a
# local one must not be baked into the image
*.duckdb
*.duckdb.wal

# Ad-hoc data exports, not part of the pipeline
*.csv

# Host folder mounted at /data at run time, never part of the image
output

# Secrets
.env

# Editor
.vscode
